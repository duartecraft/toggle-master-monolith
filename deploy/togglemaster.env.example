# Modelo de variáveis de ambiente para a EC2.
# Copie para /etc/togglemaster.env, preencha e proteja:
#   sudo cp deploy/togglemaster.env.example /etc/togglemaster.env
#   sudo chmod 600 /etc/togglemaster.env
# NUNCA versione o arquivo preenchido no Git.

DB_HOST=<endpoint-do-rds>.sa-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=togglemaster
DB_USER=postgres
DB_PASSWORD=<senha-do-rds>
DB_SSLMODE=require
